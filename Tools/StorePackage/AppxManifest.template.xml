<?xml version="1.0" encoding="utf-8"?>
<!-- Jelly Survival MSIX manifest template. package_store.py fills the {placeholders} from store_config.json.
     Full-trust desktop app (Unity player), x64. Declared: runFullTrust (required for a desktop app),
     internetClientServer and privateNetworkClientServer (a player hosts the room inside the game and friends connect
     to it over the internet or the same router, docs/work/player-host.md), and an inbound firewall rule for the game
     port so Windows does not block the host's room.
     Schema: https://learn.microsoft.com/en-us/windows/msix/desktop/desktop-to-uwp-manual-conversion -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  IgnorableNamespaces="uap uap10 rescap desktop2">

  <Identity Name="{identityName}" Version="{version}" Publisher="{publisher}" ProcessorArchitecture="{processorArchitecture}" />

  <Properties>
    <DisplayName>{displayName}</DisplayName>
    <PublisherDisplayName>{publisherDisplayName}</PublisherDisplayName>
    <Description>{description}</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
{resources}
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="{minVersion}" MaxVersionTested="{maxVersionTested}" />
  </Dependencies>

  <Capabilities>
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="{applicationId}" Executable="{executable}"
      uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="{displayName}" Description="{description}" BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png"
          Square310x310Logo="Assets\LargeTile.png" ShortName="{displayName}">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
      </uap:VisualElements>
    </Application>
  </Applications>

  <Extensions>
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="{executable}">
        <desktop2:Rule Direction="in" IPProtocol="TCP" Profile="all" LocalPortMin="{gamePort}" LocalPortMax="{gamePort}" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>
</Package>
