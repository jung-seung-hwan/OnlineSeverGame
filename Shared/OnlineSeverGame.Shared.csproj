<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unity compatible: C# 9 and netstandard2.1 APIs only. Also used by Unity as a local package (package.json + asmdef). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>OnlineSeverGame.Shared</RootNamespace>
    <AssemblyName>OnlineSeverGame.Shared</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="package.json;*.asmdef;**/*.meta" />
  </ItemGroup>

</Project>
